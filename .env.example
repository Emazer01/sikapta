# SIKAPTA AI - Konfigurasi Lingkungan (Environment Variables)

# Identitas Aplikasi
APP_NAME=SIKAPTA AI
PROJECT_NAME="SIKAPTA AI Core Service"
VERSION=1.0.0

# Keamanan (Ganti nilai ini pada instalasi produksi)
SECRET_KEY=sikapta-ai-super-secret-key-change-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database PostgreSQL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sikapta_ai

# Fallback Database SQLite (Otomatis digunakan jika PostgreSQL tidak merespons)
# SQLITE_FALLBACK_URL=sqlite:///data/sikapta_ai.db

# Pengaturan Kamera & Vision Engine
DEFAULT_VISION_MODEL=mediapipe
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480
CAMERA_TARGET_FPS=30
JPEG_QUALITY=75

